# ──────────────────────────────────────────────────────────────
# SFx Lite API — environment configuration
# Copy is created automatically as .env on first `npm run start`.
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ────────────────────────────────────────────
# Anonymous requests are tracked by IP; authenticated requests by user id.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_IP=30
THROTTLE_LIMIT_USER=100

# ── Database (Neon Postgres — pgvector enabled) ──────────────
# We use a SHARED cloud database (Neon). Get the real connection string
# from the team (password manager / team chat) — do NOT commit it here.
# Cloud Postgres requires SSL: keep ?sslmode=require and DATABASE_SSL=true.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_SSL=true
DATABASE_LOGGING=false

# ── Cache (OPTIONAL) ─────────────────────────────────────────
# Leave REDIS_URL empty to run on the built-in in-memory cache — no Docker,
# no Redis needed for local dev, staging, or prod. Set it (and `npm i ioredis`)
# only when you want a shared/distributed cache across instances.
# e.g. redis://localhost:6379  or  rediss://user:pass@host:6379
REDIS_URL=
CACHE_TTL_SECONDS=60
CACHE_MAX_ITEMS=1000

# ── Auth (Squad A ) ─────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── Blockchain (Squad B) ──────────────────
# Mnemonic is a secret.
ALCHEMY_AMOY_RPC_URL=
MASTER_WALLET_MNEMONIC=
USDC_TOKEN_ADDRESS=
DEPOSIT_CONFIRMATIONS=3
# Max block span per eth_getLogs call. Alchemy Amoy free tier = 10. Raise only
# on a paid/self-hosted RPC (PAYG, dRPC, your own node).
GETLOGS_MAX_RANGE=10

# ── Storage (Squad A — KYC uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI support (Squad D) ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Transactional email (Resend) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=SFX Lite <notifications@example.com>

# ── Root admin (RBAC) ────────────────────────────────────────
# On login with ROOT_ADMIN_EMAIL, the account is created (as super_admin)
# if it does not exist, or its password is verified if it does. This is the
# only self-provisioning admin — all other admins are promoted by a super_admin.
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=
ROOT_ADMIN_USERNAME=root_admin